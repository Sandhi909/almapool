# Copy jadi .env di VM, isi sesuai kredensial VM
APP_ENV=production
APP_NAME="Kolam Renang Al Ma'soem"
BASE_URL=""
# Untuk VM kamu /var/www/almapool -> kosongkan (DocumentRoot = /var/www/almapool)
# Jika nanti diakses via subfolder https://example.com/almapool -> isi BASE_URL=/almapool

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_kolam_renang
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
APP_TIMEZONE=Asia/Jakarta
# Lama session login (detik). Default 86400 = 24 jam (login sehari sekali).
# SESSION_LIFETIME=86400
